{
  "name": "ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/ui.es.js",
  "module": "./dist/ui.es.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "docs",
    "!docs/handoff.md"
  ],
  "bin": {
    "ui": "./bin/ui.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ui.es.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.es.js"
    },
    "./viewers": {
      "types": "./dist/types/viewers.d.ts",
      "import": "./dist/viewers.es.js"
    },
    "./markdown": {
      "types": "./dist/types/markdown.d.ts",
      "import": "./dist/markdown.es.js"
    },
    "./cad": {
      "types": "./dist/types/cad.d.ts",
      "import": "./dist/cad.es.js"
    },
    "./styles.css": {
      "types": "./dist/ui.d.css.ts",
      "default": "./dist/ui.css"
    },
    "./dist/ui.css": {
      "types": "./dist/ui.d.css.ts",
      "default": "./dist/ui.css"
    },
    "./styles/tokens.css": {
      "types": "./dist/styles/tokens.d.css.ts",
      "default": "./dist/styles/tokens.css"
    },
    "./styles/base.css": {
      "types": "./dist/styles/base.d.css.ts",
      "default": "./dist/styles/base.css"
    },
    "./styles/fonts.css": {
      "types": "./dist/styles/fonts.d.css.ts",
      "default": "./dist/styles/fonts.css"
    },
    "./styles/core.css": {
      "types": "./dist/styles/core.d.css.ts",
      "default": "./dist/styles/core.css"
    },
    "./styles/viewers.css": {
      "types": "./dist/styles/viewers.d.css.ts",
      "default": "./dist/styles/viewers.css"
    },
    "./styles/markdown.css": {
      "types": "./dist/styles/markdown.d.css.ts",
      "default": "./dist/styles/markdown.css"
    },
    "./styles/cad.css": {
      "types": "./dist/styles/cad.d.css.ts",
      "default": "./dist/styles/cad.css"
    },
    "./styles/katex.css": {
      "types": "./dist/styles/katex.d.css.ts",
      "default": "./dist/styles/katex.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "demo": "bun ./bin/ui.mjs demo",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/write-package-assets.mjs",
    "typecheck": "tsc -b --noEmit",
    "typecheck:package": "tsc -p tsconfig.build.json --noEmit --emitDeclarationOnly false",
    "test": "bun test",
    "lint": "eslint src examples design-lab tests",
    "lint:package": "eslint src/components src/index.ts src/core.ts src/viewers.ts src/markdown.ts src/cad.ts vite.config.ts scripts/write-package-assets.mjs tests/packageExports.test.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.3.13",
    "dxf-viewer": "^1.0.47",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "occt-import-js": "^0.0.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-texmath": "^1.0.0"
  }
}
